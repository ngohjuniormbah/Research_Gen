{
  "info": {
    "name": "Research_Gen API",
    "description": "Literature Review Generator backend. Set the `base_url` variable, run 'Issue API Key' first (it auto-captures `api_key`), then Documents → Reviews (the poll flow auto-captures `job_id` and `review_id`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "api_key", "value": "" },
    { "key": "document_id", "value": "" },
    { "key": "job_id", "value": "" },
    { "key": "review_id", "value": "" },
    { "key": "export_job_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "Liveness (healthz)", "request": { "method": "GET", "url": "{{base_url}}/healthz" } },
        { "name": "Readiness (readyz)", "request": { "method": "GET", "url": "{{base_url}}/readyz" } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Issue API Key",
          "event": [
            { "listen": "test", "script": { "exec": [
              "const b = pm.response.json();",
              "if (b.api_key) { pm.collectionVariables.set('api_key', b.api_key); }",
              "pm.test('201 created', () => pm.response.code === 201);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{base_url}}/api/v1/auth/api-keys",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"you@example.com\",\n  \"name\": \"postman\"\n}" }
          }
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
            "url": "{{base_url}}/api/v1/auth/api-keys"
          }
        },
        {
          "name": "Revoke API Key",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
            "url": "{{base_url}}/api/v1/auth/api-keys/:key_id"
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload Document",
          "event": [
            { "listen": "test", "script": { "exec": [
              "const b = pm.response.json();",
              "if (b.id) { pm.collectionVariables.set('document_id', b.id); }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
            "url": "{{base_url}}/api/v1/documents",
            "body": { "mode": "formdata", "formdata": [ { "key": "file", "type": "file", "src": "papers.csv" } ] }
          }
        },
        {
          "name": "Get Document",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
            "url": "{{base_url}}/api/v1/documents/{{document_id}}"
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Submit Review (202)",
          "event": [
            { "listen": "test", "script": { "exec": [
              "const b = pm.response.json();",
              "if (b.id) { pm.collectionVariables.set('job_id', b.id); }",
              "if (b.result && b.result.review_id) { pm.collectionVariables.set('review_id', b.result.review_id); }",
              "pm.test('202 accepted', () => pm.response.code === 202);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{api_key}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": "{{base_url}}/api/v1/reviews",
            "body": { "mode": "raw", "raw": "{\n  \"topic\": \"attention mechanisms\",\n  \"records\": [\n    { \"title\": \"Transformers\", \"abstract\": \"Attention is all you need\", \"year\": 2017 }\n  ],\n  \"document_ids\": []\n}" }
          }
        },
        {
          "name": "Poll Job",
          "event": [
            { "listen": "test", "script": { "exec": [
              "const b = pm.response.json();",
              "if (b.result && b.result.review_id) { pm.collectionVariables.set('review_id', b.result.review_id); }",
              "pm.test('job present', () => pm.expect(b.status).to.be.oneOf(['queued','running','succeeded','failed']));"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
            "url": "{{base_url}}/api/v1/reviews/jobs/{{job_id}}"
          }
        },
        {
          "name": "Get Review",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
            "url": "{{base_url}}/api/v1/reviews/{{review_id}}"
          }
        },
        {
          "name": "Preview (HTML)",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
            "url": "{{base_url}}/api/v1/reviews/{{review_id}}/preview?format=html"
          }
        },
        {
          "name": "Export (md)",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
            "url": "{{base_url}}/api/v1/reviews/{{review_id}}/export?format=md"
          }
        },
        {
          "name": "Export (docx)",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
            "url": "{{base_url}}/api/v1/reviews/{{review_id}}/export?format=docx"
          }
        },
        {
          "name": "Export (pdf, async 202)",
          "event": [
            { "listen": "test", "script": { "exec": [
              "const b = pm.response.json();",
              "if (b.id) { pm.collectionVariables.set('export_job_id', b.id); }"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
            "url": "{{base_url}}/api/v1/reviews/{{review_id}}/export?format=pdf"
          }
        },
        {
          "name": "Poll Export Job",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
            "url": "{{base_url}}/api/v1/reviews/jobs/{{export_job_id}}"
          }
        }
      ]
    },
    {
      "name": "ORKG",
      "item": [
        {
          "name": "Connect",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{api_key}}" }
            ],
            "url": "{{base_url}}/api/v1/orkg/connect",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"you@example.com\",\n  \"password\": \"...\"\n}" }
          }
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-API-Key", "value": "{{api_key}}" } ],
            "url": "{{base_url}}/api/v1/orkg/search?q=knowledge graphs&size=20"
          }
        },
        {
          "name": "SPARQL (guarded)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{api_key}}" }
            ],
            "url": "{{base_url}}/api/v1/orkg/sparql",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"SELECT ?s ?p ?o WHERE { ?s ?p ?o }\",\n  \"limit\": 25\n}" }
          }
        }
      ]
    }
  ]
}
