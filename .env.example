# Copy to .env for local dev. NEVER commit a real .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# JSON list. LOCK THIS DOWN in staging/production, e.g. ["https://app.example.com"].
# "*" allows any origin (anonymous only — credentials are auto-disabled with a wildcard).
CORS_ORIGINS=["*"]

# --- Datastores ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/litreview
REDIS_URL=redis://localhost:6379/0

# --- Jobs ---
# true runs generation inline in the request (dev/CI). false = enqueue to arq worker.
JOBS_EAGER=false

# --- Observability (Sentry is a no-op when the DSN is empty) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Security / secrets ---
# Fernet key encrypting ORKG tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# HMAC secret signing temporary export download URLs. Set a long random value in prod.
EXPORT_URL_SECRET=dev-insecure-change-me
EXPORT_URL_TTL_S=900

# --- Validation limits ---
MAX_UPLOAD_BYTES=10000000
MAX_SOURCE_RECORDS=500

# --- Export / rendering ("pandoc" needs the pandoc binary; "fake" is deterministic) ---
EXPORT_RENDERER=pandoc
PANDOC_PDF_ENGINE=weasyprint

# --- Rate limiting (Redis, per API key) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_GENERATIONS=3
SPARQL_RATE_LIMIT_PER_MINUTE=10

# --- Idempotency ---
IDEMPOTENCY_TTL_S=86400

# --- Storage (local FS in dev; S3/MinIO fields wired via the StorageBackend) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/uploads
S3_ENDPOINT_URL=
S3_BUCKET=litreview
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- LLM registry ---
# Default provider used when a request doesn't name one. `fake` needs no network/keys.
LLM_DEFAULT_PROVIDER=fake
LLM_MAX_CONTEXT_TOKENS=8000
LLM_REQUEST_TIMEOUT_S=120
# Override/extend the whole registry from env (adding a model = one entry, no code):
# LLM_PROVIDERS='{"gemma": {"base_url": "http://localhost:11434/v1", "model": "gemma2", "api_key": ""}}'

# --- Paid ChatGPT / OpenAI (easiest path) ---
# Set the key to auto-register an "openai" provider, then select it as the default.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini          # or gpt-4o, gpt-4.1, etc.
# LLM_DEFAULT_PROVIDER=openai

# --- Open-source models via OpenRouter (one key -> many models, works without a GPU) ---
# Auto-registers: llama, qwen, deepseek, commandr, gemma, mistral (frontend picks one).
# OPENROUTER_API_KEY=sk-or-...
# LLM_DEFAULT_PROVIDER=qwen

# --- ORKG integration ---
ORKG_OIDC_URL=https://accounts.orkg.org/realms/orkg
ORKG_CLIENT_ID=orkg-client
ORKG_API_URL=https://orkg.org/api
ORKG_SPARQL_URL=https://orkg.org/triplestore
ORKG_SPARQL_MAX_LIMIT=500
ORKG_SPARQL_TIMEOUT_S=30
