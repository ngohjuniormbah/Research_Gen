# Copy to .env for local dev. NEVER commit a real .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# JSON list, e.g. ["https://app.example.com"]. Locked down in staging.
CORS_ORIGINS=["*"]

# Wired into real dependencies in Slice 2.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/litreview
REDIS_URL=redis://localhost:6379/0
